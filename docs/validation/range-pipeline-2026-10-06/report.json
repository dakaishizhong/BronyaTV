  "rootCauses": [
    "Completed but unconsumed futures occupied pending.size, preventing replacement HTTP work despite idle worker capacity.",
    "512 KiB ranges and a one-wave queue amplified request TTFB and made the head range sensitive to WAN jitter.",
    "The initial 64 KiB probe body completed synchronously before other requests could begin.",
    "Separate disk and foreground downloaders competed for the same permits and cancelled background bodies."
  ],
  "scheduler": {
    "maximumActiveHttpRequests": "configuredConnections (1/2/4/8); workers refill immediately, independently of completed chunk consumption",
    "admission": "foreground demand or a waiting read, worker capacity, bounded payload allocations and byte offset horizon",
    "ordering": "one monotonic offset allocator; out-of-order completion, partial streaming of the earliest chunk only",
    "startup": "validate fresh 206 headers before scheduling other workers; the useful first <=256 KiB body overlaps those requests",
    "chunkPolicy": "1-2 MiB preferred; rounded to 64 KiB units under memory pressure; startup wave <=1 MiB, ramps by 256 KiB per wave",
    "pause": "LoadControl demand=false stops new foreground ranges; in-flight bodies finish; a waiting extractor read can request data",
    "validation": "strict offset/end/total/length/identity encoding, ETag and Last-Modified consistency, If-Range, exact EOF416; HTTP200 uses native fallback; native206 fallback is also checked"
  },
  "diskCoordination": {
    "architecture": "DiskPrefetcher contains no HTTP downloader. The single range scheduler serves Media3 and offers the same bodies to disk.",
    "priority": "disk-only ranges start only after foreground byte horizon/window is filled or foreground demand pauses, at most one normally; no permit preemption",
    "diskIo": "separate commit executor; a blocked disk commit retains its reserved body but releases the HTTP worker",
    "foregroundWrites": "nonblocking offer; at most two copy bodies including the one being written; skip busy writes",
    "cacheReads": "reuse validated spans first; nonblocking hole lookup; cache misses use the shared network scheduler",
    "seek": "cancel old reader HTTP immediately, invalidate outstanding write leases by generation; keep valid committed spans",
    "sourceIsolation": "fresh identity validation; unique per-player UUID key retained; invalidation never exposes old spans; signed redirects preserve provider query and strip cross-origin Emby credentials",
    "failure": "low disk space/failed writer stops new writes and disk-only work but keeps already verified cache spans readable",
    "singleConnection": "one-byte fresh identity probe and one continuous native HTTP body per missing cache gap; no per-chunk HTTP restart"
  },
  "memory": {
    "rangePayloadMaximumBytes": 33554432,
    "lowMemoryMaximumBytes": 4194304,
    "formula": "min(32 MiB, heapMax/8, (heapMax-usedHeap)/8); low-memory devices force one connection and cap at 4 MiB",
    "reservations": "foreground window plus one disk-only body, one eviction retry body, two asynchronous copy bodies fit this same cap",
    "minimumWorkerWaves": 2,
    "maximumChunkMetadata": 1024,
    "media3": "separately bounded by existing BufferPolicy; headroom reserves 32 MiB for the shared pipeline; startup/time/buffer settings retained",
    "scope": "payload arrays and retained disk copies; this is not a 32 MiB ceiling for the whole app, decoders, OS TCP buffers or the benchmark fixture"
  },
  "methodology": {
    "transport": "real OkHttp HTTP/1.1 connections to MockWebServer on loopback; actual socket acquisition/release events, binary response bodies and real filesystem writes",
    "delay": "20/50/100/200 ms server response-header delay (TTFB simulation), not physical Internet RTT or a netem TCP path",
    "limiting": "independent rate limit on each response/TCP lane; fixed signed query and authorization assertions",
    "consumer": "separate loader and independently paced 20/50/80/100 Mbps playback queue; underrun after a 20 ms empty queue wait",
    "comparison": "64 MiB fixture, 8 lanes, 200 ms TTFB; per lane 16/16/18 Mbps at 50/80/100; 2 MiB playable priming, 4 MiB playable queue, same source bytes",
    "matrix": "32 MiB fixture, 4 rates x 4 TTFB delays x 3 connection counts x disk off/on = 96 cases; seeded occasional body delay of 2*TTFB produces slow/out-of-order ranges",
    "matrixSupply": "8 lanes use max(16, floor(1.5*consumerMbps/lanes)) Mbps per lane; 2/4 lanes use 3x, or 4x at >=80 Mbps and 200 ms, so effective HTTP capacity is adequate",
