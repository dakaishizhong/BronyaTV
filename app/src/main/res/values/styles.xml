<resources>
    <color name="background">#0B101B</color>
    <color name="accent">#FFB45C</color>
    <style name="Theme.Ember" parent="Theme.Leanback">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
    <style name="Theme.Ember.Player" parent="Theme.Ember">
        <item name="android:windowFullscreen">true</item>
    </style>
</resources>
